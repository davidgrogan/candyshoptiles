# Copy to .env for local dev (optional -- with nothing set, the app uses
# the SQLite file in instance/ and the admin/admin dev login). On the
# droplet these come from deploy/candyshoptiles.env instead, via systemd's
# EnvironmentFile= (see DEPLOY.md).

# Leave blank locally to use SQLite (instance/candyshoptiles.sqlite3).
# Set to a Postgres URL to test against Postgres, e.g.
# postgresql://candyshoptiles:password@127.0.0.1:5432/candyshoptiles
DATABASE_URL=

# Any long random string -- signs Flask's session cookie.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Admin login. Leave the hash blank locally to use admin/admin. On a
# Postgres (production) database the admin/admin fallback is refused
# outright, so this MUST be set on the droplet.
#   python3 -c "from werkzeug.security import generate_password_hash as g; print(g('your-real-password'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Order-request notification emails, sent via Resend's HTTPS API
# (https://resend.com/api-keys) -- not SMTP, which is blocked from the
# droplet. Without a key, orders are still saved and show up under
# Admin -> Orders; you just don't get an email.
RESEND_API_KEY=
# Optional -- defaults to Resend's zero-setup onboarding@resend.dev sender.
RESEND_FROM_EMAIL=
# Where order notifications go. No email is sent if this is blank.
ORDER_NOTIFY_EMAIL=
