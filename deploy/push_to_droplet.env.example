# Copy to deploy/push_to_droplet.env (gitignored -- never committed) and
# fill in real values. Read by deploy_all.sh on your laptop.

# Same SSH user + IP you use to `ssh` in by hand.
DROPLET_SSH_USER=root
DROPLET_IP=YOUR_DROPLET_IP

# The candyshoptiles Postgres user's password (DEPLOY.md step 2) --
# NOT your SSH password, and not the localarts one.
DROPLET_PG_PASSWORD=YOUR_PG_PASSWORD

# Local port for the Postgres tunnel. 5434 so it can't clash with
# Paradise City Music's 5433 tunnel.
LOCAL_TUNNEL_PORT=5434

# Defaults match DEPLOY.md -- only uncomment if your setup differs.
# DROPLET_APP_DIR=/var/www/candyshoptiles
# DROPLET_SERVICE_NAME=candyshoptiles.service
# DROPLET_APP_PORT=8010
# DROPLET_PG_DB=candyshoptiles
# DROPLET_PG_USER=candyshoptiles
