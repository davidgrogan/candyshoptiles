# On the droplet: copy to deploy/candyshoptiles.env (gitignored -- it holds
# real secrets) and fill in. Loaded by the systemd unit (EnvironmentFile=)
# and by deploy_all.sh before running sync_schema.py.

DATABASE_URL=postgresql://candyshoptiles:REPLACE_ME@127.0.0.1:5432/candyshoptiles

#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_ME

# Separate cookie name from localarts_session and any other app on
# waveyvibe.dev. Path-scoped to this app's mount point; unset it (or set
# "/") if this app ever also gets its own domain -- see the matching note
# in DEPLOY.md.
SESSION_COOKIE_NAME=candyshoptiles_session
SESSION_COOKIE_PATH=/candyshoptiles

# Required here -- on Postgres there is no admin/admin fallback.
#   python3 -c "from werkzeug.security import generate_password_hash as g; print(g('your-real-password'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=REPLACE_ME

# Order-request emails via Resend (https://resend.com/api-keys). Optional:
# without them, orders still save and show under Admin -> Orders.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ORDER_NOTIFY_EMAIL=
